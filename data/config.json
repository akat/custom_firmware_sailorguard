{
  "title": "Anchor Guard Configuration",
  "description": "Windlass, chain counter, and alert settings.",
  "sections": [
    {
      "title": "Motor Control",
      "description": "Windlass behavior. Pins are fixed: IO26=power, IO27=direction (LOW=UP, HIGH=DOWN).",
      "fields": [
        {
          "key": "enabled",
          "label": "Enabled",
          "type": "bool",
          "default": true
        },
        {
          "key": "neutral_ms",
          "label": "Neutral Delay (ms)",
          "type": "number",
          "default": 400,
          "min": 0,
          "max": 5000,
          "help": "Dead-time between direction changes to protect the H-bridge."
        },
        {
          "key": "ff_use_meters",
          "label": "Freefall by Meters",
          "type": "bool",
          "default": false,
          "help": "When enabled, freefall releases chain by meters instead of time."
        },
        {
          "key": "ff_value",
          "label": "Freefall Value",
          "type": "number",
          "default": 5,
          "min": 0.5,
          "max": 200,
          "help": "Seconds (if by time) or meters of chain (if by meters)."
        }
      ]
    },
    {
      "title": "Chain Counter",
      "description": "Chain sensor and calibration. Sensor pin is configurable; all other hardware is fixed.",
      "fields": [
        {
          "key": "chain_sen_pin",
          "label": "Chain Sensor GPIO",
          "type": "gpio",
          "default": 25,
          "min": 0,
          "max": 39
        },
        {
          "key": "chain_pullup",
          "label": "Enable Internal Pull-up",
          "type": "bool",
          "default": true
        },
        {
          "key": "chain_cal",
          "label": "Meters per Pulse",
          "type": "number",
          "default": 1,
          "min": 0.1,
          "max": 10
        },
        {
          "key": "pulse_dbnc_ms",
          "label": "Pulse Debounce (ms)",
          "type": "number",
          "default": 150,
          "max": 1000
        }
      ]
    },
    {
      "title": "External Inputs",
      "description": "Passive sense inputs for direction tracking. Fixed pins: IO16=UP, IO17=DOWN (active HIGH).",
      "fields": [
        {
          "key": "ext_dbnc_ms",
          "label": "Debounce (ms)",
          "type": "number",
          "default": 50,
          "min": 10,
          "max": 1000,
          "help": "Debounce time for external sense inputs."
        }
      ]
    },
    {
      "title": "Alerts",
      "description": "Buzzer threshold behavior.",
      "fields": [
        {
          "key": "base_thresh_m",
          "label": "Base Threshold (m)",
          "type": "number",
          "default": 20,
          "min": 0,
          "max": 500
        },
        {
          "key": "step_m",
          "label": "Step (m)",
          "type": "number",
          "default": 10,
          "min": 1,
          "max": 200
        },
        {
          "key": "base_beeps",
          "label": "Base Beeps",
          "type": "number",
          "default": 1,
          "min": 1,
          "max": 10
        },
        {
          "key": "beeps_per_step",
          "label": "Beeps per Step",
          "type": "number",
          "default": 1,
          "min": 1,
          "max": 5
        },
        {
          "key": "beep_on_dir",
          "label": "Beep On Direction",
          "type": "select",
          "default": "DOWN",
          "options": [
            { "label": "DOWN", "value": "DOWN" },
            { "label": "UP", "value": "UP" },
            { "label": "BOTH", "value": "BOTH" }
          ]
        }
      ]
    }
  ]
}
